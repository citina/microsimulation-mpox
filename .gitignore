# Ignore temporary files in input/ that start with ~ (e.g., Office lock files)
input/~*

MonteCarloResults/*
!MonteCarloResults/new_mpox2024_S*/
!MonteCarloResults/ve*_mpox2024_S*/
!MonteCarloResults/2Xnew_mpox2024_S*/
MonteCarloResults/new_mpox2024_S*/*
MonteCarloResults/ve*_mpox2024_S*/*
MonteCarloResults/2Xnew_mpox2024_S*/*
!MonteCarloResults/new_mpox2024_S*/*.csv
!MonteCarloResults/new_mpox2024_S*/*.txt
!MonteCarloResults/ve*_mpox2024_S*/*.csv
!MonteCarloResults/ve*_mpox2024_S*/*.txt
!MonteCarloResults/2Xnew_mpox2024_S*/*.csv
!MonteCarloResults/2Xnew_mpox2024_S*/*.txt

# Allow syncing of 0.5X scenario results
!MonteCarloResults/0.5X*_mpox2024_S*/
MonteCarloResults/0.5X*_mpox2024_S*/*
!MonteCarloResults/0.5X*_mpox2024_S*/*.csv
!MonteCarloResults/0.5X*_mpox2024_S*/*.txt

# Allow syncing of import_undiag scenario results
!MonteCarloResults/import_undiag_mpox2024_S*/
MonteCarloResults/import_undiag_mpox2024_S*/*
!MonteCarloResults/import_undiag_mpox2024_S*/*.csv
!MonteCarloResults/import_undiag_mpox2024_S*/*.txt
!MonteCarloResults/import_undiag_mpox2024_S*/iter*/
!MonteCarloResults/import_undiag_mpox2024_S*/iter*/*.csv
!MonteCarloResults/import_undiag_mpox2024_S*/iter*/*.txt
!MonteCarloResults/import_undiag_mpox2024_S*/iter*/state_matrices/
!MonteCarloResults/import_undiag_mpox2024_S*/iter*/state_matrices/*.csv

# Allow syncing of import_asymp scenario results
!MonteCarloResults/import_asymp*_mpox2024_S*/
MonteCarloResults/import_asymp*_mpox2024_S*/*
!MonteCarloResults/import_asymp*_mpox2024_S*/*.csv
!MonteCarloResults/import_asymp*_mpox2024_S*/*.txt
!MonteCarloResults/import_asymp*_mpox2024_S*/iter*/
!MonteCarloResults/import_asymp*_mpox2024_S*/iter*/*.csv
!MonteCarloResults/import_asymp*_mpox2024_S*/iter*/*.txt
!MonteCarloResults/import_asymp*_mpox2024_S*/iter*/state_matrices/
!MonteCarloResults/import_asymp*_mpox2024_S*/iter*/state_matrices/*.csv

